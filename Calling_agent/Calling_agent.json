      "typeVersion": 1.3,
      "position": [
        220,
        0
      ],
      "id": "YOUR_ID",
      "name": "Google Calendar",
      "credentials": {}
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=appointment details: {{ $json.description }}\n\nstart time:{{ $json.start.dateTime }}\nend time:{{ $json.end.dateTime }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a You are an assistant. Generate structured JSON with the following fields:\n\n- name: full name of the recipient\n\n- phone_number: string\n\n- reason: reason for the appointment\n\n- start_time: ISO 8601 datetime (Format is date-time)\n\n- end_time: ISO 8601 datetime (Format is date-time)\n\n- email\n\nOutput ONLY in this exact JSON format. No comments, no extra text.helpful assistant"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        440,
        0
      ],
      "id": "YOUR_ID",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        460,
        220
      ],
      "id": "YOUR_ID",
      "name": "OpenAI Chat Model",
      "credentials": {}
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"output\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"name\": { \"type\": \"string\" },\n        \"phone_number\": { \"type\": \"string\" },\n        \"reason\": { \"type\": \"string\" },\n        \"start_time\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"end_time\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"email\": { \"type\": \"string\", \"format\": \"email\" }\n      },\n      \"required\": [\"name\", \"phone_number\", \"start_time\", \"end_time\", \"email\"]\n    }\n  },\n  \"required\": [\"output\"]\n}\n"
      },
      "type": "@n8n/n8n-nodes-langchain.YOUR_ID",
      "typeVersion": 1.2,
      "position": [
        620,
        220
      ],
      "id": "YOUR_ID",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.retellai.com/v2/create-phone-call",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\n  \"Authorization\": \"Bearer YOUR_API_KEY\",\n  \"Content-Type\": \"application/json\"\n}\n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from_number\": \"+0000000000\",\n  \"to_number\": \"{{ $json.output.phone_number }}\",\n  \"YOUR_ID\": {\n    \"name\": \"{{ $json.output.name }}\",\n    \"reason\": \"{{ $json.output.reason }}\",\n    \"start_time\": \"{{ $json.output.start_time }}\",\n    \"end_time\": \"{{ $json.output.end_time }}\"\n  },\n  \"override_agent_id\": \"YOUR_ID\"\n}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "id": "YOUR_ID",
      "name": "HTTP Request"
    }
  ],
